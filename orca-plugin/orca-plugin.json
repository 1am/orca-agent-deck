{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "agent-deck",
  "name": "Agent Deck for Orca",
  "version": "0.2.2",
  "description": "Shows Orca agent status on a Stream Deck and focuses panes from it.",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "A Stream Deck showing Orca agent panes as colored keys: working, done, idle and empty"
  },
  "screenshots": [
    {
      "path": "images/deck.png",
      "alt": "A 5x3 Stream Deck grid of Orca pane keys with status icons",
      "caption": "Pane keys mirror Orca agent status"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "main": "main.mjs",
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:write"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "deck.map",
        "title": "Agent Deck: Open panel",
        "when": "global"
      },
      {
        "id": "deck.status",
        "title": "Agent Deck: Show status",
        "when": "global"
      },
      {
        "id": "deck.uninstall",
        "title": "Agent Deck: Uninstall",
        "when": "global"
      }
    ],
    "statusBarItems": [
      {
        "id": "deck",
        "icon": "link",
        "text": "Agent Deck",
        "tooltip": "Open Agent Deck: the panel to map terminal panes to Stream Deck keys",
        "command": "deck.map"
      }
    ],
    "keybindings": [
      {
        "command": "deck.map",
        "key": "Mod+Alt+K"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  }
}
