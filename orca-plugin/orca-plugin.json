{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "agent-deck",
  "name": "Agent Deck for Orca",
  "version": "0.2.1",
  "description": "Shows Orca agent status on a Stream Deck and focuses panes from it.",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "A Stream Deck showing Orca agent panes as colored keys: working, done, idle and empty"
  },
  "screenshots": [
    {
      "path": "images/deck.png",
      "alt": "A 5x3 Stream Deck grid of Orca pane keys with status icons",
      "caption": "Pane keys mirror Orca agent status"
    }
  ],
  "engines": {
    "orca": ">=1.4.246"
  },
  "main": "main.mjs",
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "deck.map",
        "title": "Agent Deck: Map pane to key",
        "when": "global"
      },
      {
        "id": "deck.unmap",
        "title": "Agent Deck: Unmap pane",
        "when": "global"
      },
      {
        "id": "deck.status",
        "title": "Agent Deck: Show status",
        "when": "global"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ]
  }
}
