{"at":0,"do":"deck.appear","key":1}
{"at":500,"do":"deck.pi.open","key":1}
{"at":500,"do":"expect.pi","key":1,"messages":[{"type":"state","panes":[{"paneKey":"tab-1:leaf-l","host":"This machine","remote":false},{"paneKey":"tab-1:leaf-r","hostId":"ssh-1","host":"remote","remote":true}]}]}
{"at":1000,"do":"orca.pane.add","pane":"n","title":"New"}
{"at":3500,"do":"expect.pi","key":1,"messages":[{"type":"state","panes":[{"paneKey":"tab-1:leaf-l"},{"paneKey":"tab-1:leaf-r"},{"paneKey":"tab-1:leaf-n"}]}]}
